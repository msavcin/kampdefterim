{
  "expo": {
    "name": "Kamp Defterim",
    "slug": "bolt-expo-nativewind",
    "platforms": [
      "android",
      "ios",
      "web"
    ],
    "version": "1.3.17",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kampdefterim",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.spondylus.kampdefterim",
      "buildNumber": "1.3.17",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Harita ve kamp alanlarını görmek için konum izni gereklidir.",
        "NSPhotoLibraryUsageDescription": "Yedek dosyalarını kaydetmek için izin gerekli.",
        "NSCameraUsageDescription": "Kamp alanı fotoğrafları eklemek için kamera izni gerekli.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "com.android.vending.BILLING"
      ],
      "package": "com.spondylus.boltexponativewind",
      "versionCode": 46
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Harita ve kamp alanlarını görmek için konum izni gereklidir.",
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      [
        "expo-file-system",
        {
          "requestLegacyExternalStorage": true
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Yedek dosyalarını Downloads klasörüne kaydetmek için izin gerekli.",
          "savePhotosPermission": "Yedek dosyalarını Downloads klasörüne kaydetmek için izin gerekli.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      "expo-sqlite",
      "expo-web-browser",
      "expo-secure-store",
      ["expo-build-properties", {"android": {"kotlinVersion": "2.0.21"}}],
      "./plugins/withIapDimensionStrategy"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "5712d230-4b8e-4709-b3b2-31694cee2237"
      }
    }
  }
}
