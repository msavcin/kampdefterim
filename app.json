{
  "expo": {
    "name": "Kamp Defterim",
    "slug": "bolt-expo-nativewind",
    "platforms": [
      "android",
      "ios",
      "web"
    ],
    "version": "1.3.24",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kampdefterim",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.spondylus.kampdefterim",
      "buildNumber": "1.3.24",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Harita ve kamp alanlarını görmek için konum izni gereklidir.",
        "NSPhotoLibraryUsageDescription": "Kamp alanı fotoğrafları eklemek için fotoğraf galerisi erişimi gerekli.",
        "NSCameraUsageDescription": "Kamp alanı fotoğrafları eklemek için kamera izni gerekli.",
        "NSLocalNetworkUsageDescription": "İnternet olmadan yakındaki kamp kullanıcılarıyla mesajlaşmak için yerel ağ erişimi gereklidir.",
        "NSBonjourServices": [
          "_kampdefterim._tcp"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.CHANGE_WIFI_MULTICAST_STATE",
        "android.permission.ACCESS_NETWORK_STATE",
        "com.android.vending.BILLING"
      ],
      "package": "com.spondylus.boltexponativewind",
      "versionCode": 60,
      "blockedPermissions": [
        "android.permission.ACTIVITY_RECOGNITION"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Harita ve kamp alanlarını görmek için konum izni gereklidir.",
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      "expo-file-system",
      "expo-sqlite",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.0.21",
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Kamp alanı fotoğrafları eklemek için fotoğraf galerisi erişimi gerekli.",
          "cameraPermission": "Kamp alanı fotoğrafları eklemek için kamera izni gerekli.",
          "isAccessMediaLocationEnabled": false,
          "preferSystemPhotoPicker": true
        }
      ],
      "./plugins/withIapDimensionStrategy",
      "./plugins/withNetworkIfIOS",
      "./plugins/withRemoveMediaPermissions"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "5712d230-4b8e-4709-b3b2-31694cee2237"
      }
    }
  }
}
